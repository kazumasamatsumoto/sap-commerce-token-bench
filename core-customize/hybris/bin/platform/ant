#!/usr/bin/env bash
# 本物の Commerce と同じく hybris/bin/platform で `ant clean all` のように使う。中身は Docker の中で動く。
here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/../../../.." && pwd)"
exec docker compose -f "$root/docker-compose.yml" --profile tools run --rm -T builder bash resources/ant/ant-impl.sh "$@"
